    {
      "fn": "parseMoney",
      "note": "plain",
      "args": ["12.5"],
      "expected": {
        "ok": true,
        "value": 12.5
      }
    },
    {
      "fn": "parseMoney",
      "note": "thousands and dollar sign",
      "args": ["$1,234.56"],
      "expected": {
        "ok": true,
        "value": 1234.56
      }
    },
    {
      "fn": "parseMoney",
      "note": "dollar sign after minus",
      "args": [
        "$-5",
        {
          "allowNegative": true
        }
      ],
      "expected": {
        "ok": true,
        "value": -5
      }
    },
    {
      "fn": "parseMoney",
      "note": "decimal comma",
      "args": ["12,50"],
      "expected": {
        "ok": true,
        "value": 12.5
      }
    },
    {
      "fn": "parseMoney",
      "note": "empty",
      "args": ["  "],
      "expected": {
        "ok": false,
        "error": "Enter an amount"
      }
    },
    {
      "fn": "parseMoney",
      "note": "not a number",
      "args": ["45O0"],
      "expected": {
        "ok": false,
        "error": "Enter an amount like 1,234.56"
      }
    },
    {
      "fn": "parseMoney",
      "note": "too many decimals",
      "args": ["10.999"],
      "expected": {
        "ok": false,
        "error": "Use at most 2 decimal places"
      }
    },
    {
      "fn": "parseMoney",
      "note": "negative not allowed",
      "args": ["-5"],
      "expected": {
        "ok": false,
        "error": "Amount can't be negative"
